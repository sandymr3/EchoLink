<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EchoLink.Views.PinPadView"
        Width="360"
        Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        Background="#121212"
        Title="EchoLink App Shield">

    <Border Padding="20" Background="#121212">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="Unlock EchoLink"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="SubtitleText"
                       Grid.Row="1"
                       Text="Enter your 4-digit PIN"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,24,0,20"
                        HorizontalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="14" Height="14" Fill="#2A2A2A"/>
                <Ellipse x:Name="Dot2" Width="14" Height="14" Fill="#2A2A2A"/>
                <Ellipse x:Name="Dot3" Width="14" Height="14" Fill="#2A2A2A"/>
                <Ellipse x:Name="Dot4" Width="14" Height="14" Fill="#2A2A2A"/>
            </StackPanel>

            <Grid Grid.Row="3" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Content="1" Click="OnDigitClick" Tag="1"/>
                <Button Grid.Row="0" Grid.Column="1" Content="2" Click="OnDigitClick" Tag="2"/>
                <Button Grid.Row="0" Grid.Column="2" Content="3" Click="OnDigitClick" Tag="3"/>

                <Button Grid.Row="1" Grid.Column="0" Content="4" Click="OnDigitClick" Tag="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Click="OnDigitClick" Tag="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Click="OnDigitClick" Tag="6"/>

                <Button Grid.Row="2" Grid.Column="0" Content="7" Click="OnDigitClick" Tag="7"/>
                <Button Grid.Row="2" Grid.Column="1" Content="8" Click="OnDigitClick" Tag="8"/>
                <Button Grid.Row="2" Grid.Column="2" Content="9" Click="OnDigitClick" Tag="9"/>

                <Button Grid.Row="3" Grid.Column="0" Content="Clear" Click="OnClearClick"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Click="OnDigitClick" Tag="0"/>
                <Button Grid.Row="3" Grid.Column="2" Content="Back" Click="OnBackspaceClick"/>
            </Grid>

            <Button Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,-54"
                    MinWidth="120"
                    Content="Cancel"
                    Click="OnCancelClick"/>
        </Grid>
    </Border>
</Window>
