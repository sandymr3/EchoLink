<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EchoLink.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="700"
             x:Class="EchoLink.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="#121212">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*">
        <Border Grid.Row="0" Padding="40">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="24"
                        Width="320">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Center">
                        <Ellipse Width="14" Height="14"
                                 Fill="#00E676"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="EchoLink"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="Mesh Network"
                               FontSize="13"
                               Foreground="#B3B3B3"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="#2D2D2D" Margin="0,8"/>

                <!-- Status text -->
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13"
                           Foreground="#B3B3B3"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Loading spinner -->
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="3"
                             Foreground="#00E676"
                             Background="#2D2D2D"/>

                <!-- Ecosystem / Standard Mode -->
                <StackPanel Spacing="16" IsVisible="{Binding !IsGuestMode}">
                    <Button Command="{Binding LoginWithGoogleCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,14"
                            CornerRadius="8"
                            Background="#00E676"
                            Foreground="#121212"
                            FontSize="15"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Log In with Google" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleGuestModeCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,14"
                            CornerRadius="8"
                            Background="#2D2D2D"
                            Foreground="#FFFFFF"
                            FontSize="15"
                            FontWeight="SemiBold">
                        <TextBlock Text="Join as Guest" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Guest Mode -->
                <StackPanel Spacing="16" IsVisible="{Binding IsGuestMode}">
                    <TextBlock Text="Enter a 6-digit PIN provided by the host device to connect temporarily."
                               FontSize="12" Foreground="#B3B3B3" TextWrapping="Wrap" TextAlignment="Center"/>

                    <TextBox Text="{Binding GuestPin}"
                             Watermark="PIN Code"
                             IsEnabled="{Binding !IsLoading}"
                             MaxLength="6"
                             TextAlignment="Center"
                             FontSize="24"
                             LetterSpacing="4"
                             Padding="10"
                             Margin="0,8"
                             CornerRadius="8"
                             Background="#1E1E1E"
                             Foreground="#FFFFFF"/>

                    <Button Command="{Binding ConnectAsGuestCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,14"
                            CornerRadius="8"
                            Background="#00E676"
                            Foreground="#121212"
                            FontSize="15"
                            FontWeight="Bold">
                        <TextBlock Text="Connect" VerticalAlignment="Center"/>
                    </Button>

                    <Button Command="{Binding ToggleGuestModeCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,14"
                            CornerRadius="8"
                            Background="Transparent"
                            Foreground="#B3B3B3"
                            FontSize="14">
                        <TextBlock Text="Back to Log In" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Cancel button — only visible while loading -->
                <Button Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,10"
                        CornerRadius="8"
                        Background="#2D2D2D"
                        Foreground="#B3B3B3"
                        FontSize="13">
                    <TextBlock Text="Cancel"/>
                </Button>

                <!-- Footer -->
                <TextBlock Text="Connects via Headscale · echo-link.app"
                           FontSize="10"
                           Foreground="#4A4A4A"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
