<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EchoLink.ViewModels"
             xmlns:m="using:EchoLink.Models"
             xmlns:conv="using:EchoLink.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
             x:Class="EchoLink.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToColorConverter x:Key="MeshStatusColor"
                                   TrueColor="#00E676"
                                   FalseColor="#FF5252"/>
    </UserControl.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Network Status"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Headscale mesh overview"
                           FontSize="13" Foreground="#B3B3B3"/>
            </StackPanel>

            <!-- Status Card -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                    <!-- Status label row -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
                                Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <Ellipse Width="16" Height="16"
                                 Fill="{Binding IsMeshOnline, Converter={StaticResource MeshStatusColor}}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Network name -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding NetworkName}"
                               FontSize="12" Foreground="#B3B3B3"
                               Margin="28,4,0,0"/>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="Secondary"
                                Command="{Binding ShowJoinPopupCommand}"
                                Content="Join Device"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Connect to another device via PIN"/>
                        <Button Classes="Secondary"
                                Command="{Binding GeneratePairingInviteCommand}"
                                Content="Pair Device"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Generate a PIN for another user to connect to you"/>
                        <Button Classes="Secondary"
                                Command="{Binding GenerateGuestInviteCommand}"
                                Content="Invite Guest"
                                VerticalAlignment="Center"/>
                        <Button Classes="Primary"
                                Command="{Binding RefreshNetworkCommand}"
                                Content="Refresh"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- IP Display -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Background="#121212"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,16,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tailscale / Headscale IP"
                                           FontSize="10" Foreground="#B3B3B3"
                                           Margin="0,0,0,2"/>
                                <SelectableTextBlock Text="{Binding TailscaleIp}"
                                                     FontSize="20" FontWeight="Bold"
                                                     FontFamily="Consolas, monospace"
                                                     Foreground="#00E5FF"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyIpCommand}"
                                    Background="Transparent"
                                    Foreground="#B3B3B3"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    ToolTip.Tip="Copy IP"
                                    VerticalAlignment="Center"
                                    Content="📋"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Invite Card (PIN Generator) -->
            <Border Classes="Card" IsVisible="{Binding IsInviteVisible}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding IsPairingInvite, Converter={StaticResource StringConverter}, ConverterParameter='Device Pairing PIN|Guest Access PIN'}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <Button Grid.Column="1"
                                Command="{Binding CloseGuestInviteCommand}"
                                Content="✕"
                                Background="Transparent"
                                Foreground="#B3B3B3"
                                Padding="4"/>
                    </Grid>
                    
                    <TextBlock Text="Share this 6-digit PIN with the other device to establish a secure connection."
                               FontSize="12" Foreground="#B3B3B3" TextWrapping="Wrap"/>
                               
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <SelectableTextBlock Text="{Binding GuestInvitePin}"
                                                 FontSize="42" FontWeight="Bold"
                                                 LetterSpacing="8"
                                                 Foreground="#00E676"
                                                 HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding InviteStatusText}"
                                       FontSize="11" Foreground="#4A4A4A"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Join Card (PIN Entry) -->
            <Border Classes="Card" IsVisible="{Binding IsJoinVisible}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="Join Other Device"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <Button Grid.Column="1"
                                Command="{Binding CloseJoinPopupCommand}"
                                Content="✕"
                                Background="Transparent"
                                Foreground="#B3B3B3"
                                Padding="4"/>
                    </Grid>
                    
                    <TextBlock Text="{Binding JoinStatusText}"
                               FontSize="12" Foreground="#B3B3B3" TextWrapping="Wrap"/>
                               
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding JoinPin}"
                                 Watermark="6-digit PIN"
                                 FontSize="24"
                                 FontWeight="Bold"
                                 HorizontalContentAlignment="Center"
                                 MaxLength="6"
                                 Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                                Command="{Binding SubmitJoinPinCommand}"
                                Content="Confirm"
                                Classes="Primary"
                                Padding="20,0"
                                VerticalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ecosystem Section -->
            <StackPanel Spacing="12" IsVisible="{Binding EcosystemDevices.Count}">
                <TextBlock Text="My Ecosystem"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#00E5FF"/>
                <ItemsControl ItemsSource="{Binding EcosystemDevices}">
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="DeviceTemplate"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Other Devices Section -->
            <StackPanel Spacing="12" IsVisible="{Binding OtherDevices.Count}">
                <TextBlock Text="Other Connected Devices"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#10B981"/>
                <ItemsControl ItemsSource="{Binding OtherDevices}">
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="DeviceTemplate"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Guests Section -->
            <StackPanel Spacing="12" IsVisible="{Binding GuestDevices.Count}">
                <TextBlock Text="Connected Guests"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#FFA726"/>
                <ItemsControl ItemsSource="{Binding GuestDevices}">
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="DeviceTemplate"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <UserControl.Resources>
        <DataTemplate x:Key="DeviceTemplate" DataType="m:Device">
            <Border Classes="Card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Device icon -->
                    <Border Grid.Column="0"
                            Width="44" Height="44"
                            Background="#121212"
                            CornerRadius="22"
                            Margin="0,0,14,0">
                        <TextBlock Text="{Binding DeviceIcon}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name + IP -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <Border IsVisible="{Binding IsSelf}" Background="#00E676" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="This device" FontSize="9" FontWeight="Bold" Foreground="#121212"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="#B3B3B3" FontFamily="Consolas, monospace"/>
                        <TextBlock Text="{Binding Os}" FontSize="11" Foreground="#4A4A4A"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Paired Status -->
                        <Border IsVisible="{Binding IsPaired}" Background="#2010B981" CornerRadius="4" Padding="4,2">
                            <TextBlock Text="🔒 Paired" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                        </Border>
                        
                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsSelf}" Spacing="4">
                            <Button Classes="Danger"
                                    IsVisible="{Binding IsPaired}"
                                    x:CompileBindings="False"
                                    Command="{Binding $parent[UserControl].DataContext.UnpairDeviceCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Padding="4,2"
                                    ToolTip.Tip="Untrust device">
                                <TextBlock Text="🔓" FontSize="10"/>
                            </Button>
                            <Button Classes="Danger"
                                    x:CompileBindings="False"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveDeviceCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Padding="4,2"
                                    ToolTip.Tip="Remove node from network">
                                <TextBlock Text="🗑️" FontSize="10"/>
                            </Button>
                        </StackPanel>

                        <Ellipse Width="8" Height="8" Fill="{Binding IsOnline, Converter={StaticResource MeshStatusColor}}"/>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{Binding IsOnline, Converter={StaticResource MeshStatusColor}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
</UserControl>
