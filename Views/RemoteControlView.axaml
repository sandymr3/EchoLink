<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EchoLink.ViewModels"
             xmlns:m="using:EchoLink.Models"
             xmlns:Converters="clr-namespace:EchoLink.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
             x:Class="EchoLink.Views.RemoteControlView"
             x:DataType="vm:RemoteControlViewModel"
             Background="Transparent">

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="0" Padding="32,24,32,16">
            <StackPanel Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Remote Control"
                               FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Send commands and control the target device remotely"
                               FontSize="13" Foreground="#B3B3B3"/>
                </StackPanel>

                <!-- Device Selection -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Target Device"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#B3B3B3"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}"
                                    Classes="Nav" Background="Transparent" Foreground="#3273F6" Padding="6,2" FontSize="12"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding OnlineDevices}"
                                  SelectedItem="{Binding SelectedTarget}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Choose a peer to control…">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="m:Device">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Opacity="{Binding IsOnline, Converter={x:Static Converters:BoolToOpacityConverter.Instance}}">
                                        <TextBlock Text="{Binding DeviceIcon}" FontSize="16"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="#B3B3B3" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Quick Actions (UniformGrid 3-col) -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Quick Actions"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B3B3B3"/>
                        <UniformGrid Columns="3" >
                            <!-- Lock -->
                            <Button Classes="Primary"
                                    Command="{Binding LockScreenCommand}"
                                    Margin="0,0,8,0"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lock Screen" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Restart -->
                            <Button Background="#FF9800"
                                    Foreground="#121212"
                                    CornerRadius="8"
                                    Padding="16,14"
                                    Margin="4,0"
                                    Command="{Binding RestartCommand}"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Restart" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Shutdown -->
                            <Button Classes="Danger"
                                    Command="{Binding ShutdownCommand}"
                                    Margin="8,0,0,0"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="⏻" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Shutdown" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Live Audio"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B3B3B3"/>

                        <TextBlock Text="{Binding AudioStatus}"
                                   FontSize="12"
                                   Foreground="#00E5FF"/>

                <Border IsVisible="{Binding IsAudioConnecting}"
                        HorizontalAlignment="Left"
                        Padding="0,2,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressBar Width="90" Height="6" IsIndeterminate="True"/>
                        <TextBlock Text="Connecting..." FontSize="12" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Classes="Primary"
                                    Command="{Binding StartAudioCommand}"
                                    Content="Start Audio"
                                    IsEnabled="{Binding CanStartAudio}"/>

                            <Button Grid.Column="1"
                                    Classes="Danger"
                                    Command="{Binding StopAudioCommand}"
                                    Content="Stop Audio"
                                    IsEnabled="{Binding CanStopAudio}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PC Keyboard Routing (PC → Android) -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="PC Keyboard (Type on PC → Phone)"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#B3B3B3"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PcKeyboardStatus}"
                                       FontSize="12"
                                       Foreground="#00E5FF"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Classes="Primary"
                                    Command="{Binding TogglePcKeyboardRoutingCommand}"
                                    Content="{Binding IsPcKeyboardRoutingEnabled, FallbackValue='Enable PC Keyboard'}"/>

                            <Border Grid.Column="1"
                                    Background="#1A1A1A"
                                    CornerRadius="8"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Hotkey:"
                                               FontSize="11"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#333333" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Ctrl+Alt+K"
                                                   FontSize="11"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Select 'EchoLink Remote Keyboard' on your phone to receive input"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Collapsible Trackpad area (outside ScrollViewer) -->
        <Border Grid.Row="1" 
                Background="#0D0D0D"
                BorderBrush="#333333"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- Expand/Collapse Toggle Bar -->
                <Button Command="{Binding ToggleTrackpadCommand}"
                        Background="#1A1A1A"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12,10"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TrackpadExpandIcon}"
                                   FontSize="14" Foreground="#00E5FF"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="🖱️" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TrackpadExpandText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TrackpadExpandIcon}"
                                   FontSize="14" Foreground="#00E5FF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Trackpad Content (visible when expanded) -->
                <StackPanel IsVisible="{Binding IsTrackpadExpanded}"
                            Spacing="8"
                            Margin="32,12,32,24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Input &amp; Trackpad"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B3B3B3"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TrackpadStatus}"
                                   FontSize="12" Foreground="#00E5FF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Mouse Click Buttons -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Content="🖱️ Left" 
                                Command="{Binding SendLeftClickCommand}"
                                Classes="Primary" 
                                Margin="0,0,4,0"
                                Padding="12,8"
                                FontSize="12"/>
                        <Button Content="🖱️ Middle" 
                                Command="{Binding SendMiddleClickCommand}"
                                Margin="4,0,4,0"
                                Padding="12,8"
                                FontSize="12"/>
                        <Button Content="🖱️ Right" 
                                Command="{Binding SendRightClickCommand}"
                                Margin="4,0,0,0"
                                Padding="12,8"
                                FontSize="12"/>
                    </UniformGrid>

                    <TextBox x:Name="KeyboardTrap"
                             Text=" "
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Watermark="Type here to send keystrokes..."
                             Background="#1A1A1A"
                             BorderBrush="#333333"
                             Foreground="#FFFFFF"
                             Margin="0,0,0,8" />

                    <Border Name="TrackpadArea"
                            Background="#1A1A1A"
                            CornerRadius="12"
                            MinHeight="180"
                            Focusable="True"
                            ClipToBounds="True">
                        <Border.Styles>
                            <Style Selector="Border:focus">
                                <Setter Property="BorderBrush" Value="#3273F6"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Style>
                        </Border.Styles>
                        <TextBlock Text="Touch and drag to move pointer"
                                   FontSize="14" Foreground="#3A3A3A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
