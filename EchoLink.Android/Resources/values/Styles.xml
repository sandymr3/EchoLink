<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    
    <!-- Translucent theme for ProcessTextActivity (invisible "Send to PC" action) -->
    <style name="MyTheme.Translucent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
